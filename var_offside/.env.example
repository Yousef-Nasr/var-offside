# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. It's only used by the optional Auto-review agent
# (var_offside.agent). The rest of the app works without it.

# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Any OpenRouter model that accepts images and JSON output 
# In the demo we use "google/gemini-3.8-flash"
OPENROUTER_MODEL_ID="google/gemini-3.8-flash"

# Limits for each Auto-review run.
OPENROUTER_MAX_COST_USD=0.50
OPENROUTER_MAX_CALLS=20

# Rollout stage, 1 to 4. At stage 1 every result is marked "Check this result".
AUTO_REVIEW_STAGE=1
