# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and only used by the optional VLM automation module
# (var_offside.automation). The core offside + 3D pipeline works without it.

# OpenRouter API key for the vision-language automation helper.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-your-key-here"

# Model id to use for automation (any OpenRouter vision model).
OPENROUTER_MODEL_ID="google/gemini-2.0-flash-001"
